# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=medical-records-secure-dev-key-replace-in-production

# AI / LLM Configuration
# Supports OpenRouter or any OpenAI-compatible endpoint
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tesseract OCR Configuration (Optional override if not in PATH)
# Example Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Example Linux: /usr/bin/tesseract
TESSERACT_PATH=

# Max Upload Size in Megabytes
MAX_CONTENT_LENGTH_MB=16
